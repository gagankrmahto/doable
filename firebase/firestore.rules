rules_version = '2';
// Doable: every record lives at users/{uid}/records/{id}. A signed-in person can read and write only
// their own records; writes must use the server's clock (sync orders changes by it) and stay small.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/records/{id} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'json', 'deleted', 'updated_at'])
        && request.resource.data.kind is string && request.resource.data.kind.size() < 32
        && request.resource.data.deleted is bool
        && (request.resource.data.json == null || (request.resource.data.json is string && request.resource.data.json.size() < 500000))
        && request.resource.data.updated_at == request.time;
    }
    // Passcode-shared spaces: an encrypted snapshot anyone with the link may fetch; only its owner can
    // publish or remove it, and the owner is pinned at creation. Without the passcode the blob is noise.
    // OAuth state for the cloud MCP server: server-side only (the Admin SDK bypasses rules)
    match /oauth/{id} { allow read, write: if false; }
    match /shared/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'blob', 'salt', 'iv', 'v', 'updated_at'])
        && request.resource.data.blob is string && request.resource.data.blob.size() < 900000
        && request.resource.data.updated_at == request.time;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner', 'blob', 'salt', 'iv', 'v', 'updated_at'])
        && request.resource.data.blob is string && request.resource.data.blob.size() < 900000
        && request.resource.data.updated_at == request.time;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
