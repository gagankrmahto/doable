{
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), payment=()"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/mcp/**",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/authorize",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/authorize/**",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/token",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/register",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/revoke",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.well-known/oauth-protected-resource/**",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      },
      {
        "source": "/.well-known/oauth-authorization-server/**",
        "function": {
          "functionId": "mcp",
          "region": "asia-south1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "calendar"
    }
  ]
}
